rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validProduct() {
      let data = request.resource.data;
      let fields = ['name', 'price', 'soluong', 'image'];
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.price is int && data.price >= 0 && data.price <= 999999999999
        && data.soluong is int && data.soluong >= 0 && data.soluong <= 999999999
        && data.image is string && data.image.size() <= 700000
        && data.image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$');
    }

    match /products/{productId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validProduct();
    }
  }
}
